# =============================================================================
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# The .env file should NEVER be committed to version control.
#
# cp .env.example .env     # Linux/macOS
# copy .env.example .env  # Windows
# =============================================================================

# MySQL Root Password (used only for MySQL container admin access)
# Generate a strong password: openssl rand -base64 32
DB_ROOT_PASSWORD=changeme_root_password_here

# MySQL Database User (non-sensitive, can keep as-is)
DB_USERNAME=analytics

# MySQL Database Password (used by application containers)
# Generate a strong password: openssl rand -base64 32
DB_PASSWORD=changeme_db_password_here

# Database Connection Settings
DB_HOST=mysql
DB_PORT=3306
DB_NAME=analytics_db

# Connection Pool Settings
DB_POOL_MAX=10
DB_POOL_MIN=5
DB_TIMEOUT_MS=30000

# Redis Distributed Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis_password_here

# Cache Toggle (set to false to disable Redis caching, useful for debugging)
CACHE_ENABLED=true

# Redis Connection Pool Settings
REDIS_POOL_MAX=8
REDIS_POOL_MAX_IDLE=4
REDIS_POOL_MIN_IDLE=1
REDIS_POOL_MAX_WAIT=5s

# ML Service Configuration
ML_SERVICE_URL=http://ml-container:8000

# Application Ports
# NOTE: After security hardening (Phase A), only WEB_PORT is exposed on the host.
# Other services use Docker 'expose:' and are reachable only via container DNS.
# The following variables are kept for backwards compatibility and may be removed in a future release.
WEB_PORT=3000
ML_CONTAINER_PORT=8000        # DEPRECATED: no longer host-bound
ESTIMATOR_API_PORT=8001       # DEPRECATED: no longer host-bound
ANALYTICS_API_PORT=8002       # DEPRECATED: no longer host-bound
MYSQL_PORT=3306               # DEPRECATED: no longer host-bound
REDIS_PORT=6379               # DEPRECATED: no longer host-bound

# Logging (TRACE, DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
