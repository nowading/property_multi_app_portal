# =============================================================================
# Property Multi-App Portal — Environment Variables Template
# Copy to `.env` and adjust values. NEVER commit the real `.env`.
# =============================================================================

# ---------- Web (Next.js portal, port 3000) ----------
# NEXT_PUBLIC_ prefix exposes these to the browser bundle for client components.
NEXT_PUBLIC_ESTIMATOR_API_URL=http://localhost:8001
NEXT_PUBLIC_ANALYTICS_API_URL=http://localhost:8002

# ---------- Estimator API (FastAPI, port 8001) ----------
ML_SERVICE_URL=http://localhost:8000
ESTIMATOR_API_PORT=8001
ESTIMATOR_API_HOST=0.0.0.0
LOG_LEVEL=INFO

# ---------- Analytics API (Spring Boot, port 8002) ----------
# These are mirrored into apps/analytics-api/src/main/resources/application.yml
ANALYTICS_API_PORT=8002
ML_SERVICE_URL_SPRING=http://localhost:8000

# ---------- ML Container (existing house_price_prediction, port 8000) ----------
ML_CONTAINER_PORT=8000
